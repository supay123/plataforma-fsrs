# En local, copia este archivo a supabase/functions/.env.

# Correo de verificación del registro. EMAIL_DELIVERY elige el proveedor:
# TODO: esto ahora esta solo con Gmail, pero se puede ampliar a otros proveedores como resend cuando se tenga un dominio verificado. 
# EMAIL_DELIVERY=gmail
# EMAIL_FROM=Chancón <chancon.envios@gmail.com>
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-...
# GMAIL_REFRESH_TOKEN=1//...

# log para mostrar en los logs de la función en vez de enviarlo; quítalo en producción.
EMAIL_DELIVERY=log
# Pagos con Kuti (QR). Llave de Desarrolladores → API keys con permiso "Lectura
# y escritura". kuti_test_… no mueve dinero; kuti_live_… cobra de verdad. Sin
# esta llave el paso de pago del registro muestra el contacto por WhatsApp.
# KUTI_SECRET_KEY=kuti_test_...
